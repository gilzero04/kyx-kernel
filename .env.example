# Server Settings
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://user:pass@host:port/db?sslmode=require

# Redis
REDIS_URL=redis://127.0.0.1:6380
REDIS_PASSWORD=password

# Security
JWT_SECRET=your_32_char_long_secret_here
ENGINE_SECRET_KEY=your_internal_handshake_secret

# Metadata
APP_VERSION=0.1.0
ENVIRONMENT=local
