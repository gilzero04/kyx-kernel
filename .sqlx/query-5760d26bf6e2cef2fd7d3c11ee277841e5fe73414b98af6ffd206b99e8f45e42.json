  "query": "\n            SELECT id, tenant_id, slug, title, content, is_published as \"is_published!\", created_at as \"created_at!\", updated_at as \"updated_at!\"\n            FROM sys_pages\n            WHERE tenant_id = $1 AND deleted_at IS NULL\n            ORDER BY created_at DESC\n            ",
