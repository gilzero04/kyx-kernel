{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, tenant_id, slug, title, content, is_published as \"is_published!\", created_at as \"created_at!\", updated_at as \"updated_at!\"\n            FROM sys_pages\n            WHERE (slug = $1 OR slug = $2) AND deleted_at IS NULL AND is_published = true\n            LIMIT 1\n            ",
