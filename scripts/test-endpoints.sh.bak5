#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# Kyx Kernel - Complete E2E API Endpoint Tests (Standardized Paths)
# ═══════════════════════════════════════════════════════════════════════════════
# Tests ALL API endpoints with standardized /admin, /public, /auth, /me structure
# Run: ./scripts/test-endpoints.sh [BASE_URL]
# ═══════════════════════════════════════════════════════════════════════════════

BASE_URL="${1:-http://localhost:8080}"
PASS=0
FAIL=0
SKIP=0
TOKEN=""
TEST_UUID="00000000-0000-0000-0000-000000000001"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

log_pass() { echo -e "${GREEN}✅ PASS${NC} $1"; PASS=$((PASS + 1)); }
log_fail() { echo -e "${RED}❌ FAIL${NC} $1 (expected: $2, got: $3)"; FAIL=$((FAIL + 1)); }
log_skip() { echo -e "${YELLOW}⏭️ SKIP${NC} $1 ($2)"; SKIP=$((SKIP + 1)); }
log_section() { echo ""; echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"; echo -e "${BLUE}  $1${NC}"; echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"; }

test_endpoint() {
    local method="$1" path="$2" expected="$3" auth="$4" body="$5"
    local curl_args=("-s" "-o" "/dev/null" "-w" "%{http_code}" "-X" "$method")
    [[ -n "$auth" ]] && curl_args+=("-H" "Authorization: Bearer $auth")
    [[ -n "$body" ]] && curl_args+=("-H" "Content-Type: application/json" "-d" "$body")
    curl_args+=("${BASE_URL}${path}")
    local status=$(curl "${curl_args[@]}" 2>/dev/null || echo "000")
    if [[ "$status" == "$expected" ]]; then log_pass "[$method] $path"; else log_fail "[$method] $path" "$expected" "$status"; fi
}

test_multi() {
    local method="$1" path="$2" expected="$3" auth="$4" body="$5"
    local curl_args=("-s" "-o" "/dev/null" "-w" "%{http_code}" "-X" "$method")
    [[ -n "$auth" ]] && curl_args+=("-H" "Authorization: Bearer $auth")
    [[ -n "$body" ]] && curl_args+=("-H" "Content-Type: application/json" "-d" "$body")
    curl_args+=("${BASE_URL}${path}")
    local status=$(curl "${curl_args[@]}" 2>/dev/null || echo "000")
    if [[ ",$expected," == *",$status,"* ]]; then log_pass "[$method] $path"; else log_fail "[$method] $path" "$expected" "$status"; fi
}

echo ""
echo "╔═══════════════════════════════════════════════════════════════════════════╗"
echo "║     Kyx Kernel - Standardized API E2E Tests                               ║"
echo "║     Structure: /auth, /admin, /public, /me, /media                        ║"
echo "╠═══════════════════════════════════════════════════════════════════════════╣"
echo "║  Base URL: $BASE_URL"
echo "╚═══════════════════════════════════════════════════════════════════════════╝"

# ═══════════════════════════════════════════════════════════════════════════════
log_section "PUBLIC ENDPOINTS (/api/v1/public/*)"
# ═══════════════════════════════════════════════════════════════════════════════
test_endpoint "GET" "/api/v1/public/system/info" "200"
test_multi "GET" "/api/v1/public/system/status" "200,500"  # 500 if DB not available
test_multi "GET" "/api/v1/public/tenants/test-slug" "200,404"
test_endpoint "GET" "/api/v1/public/themes" "200"
test_endpoint "GET" "/api/v1/public/i18n/locales" "200"
test_multi "GET" "/api/v1/public/i18n/translations/en" "200,404"

# ═══════════════════════════════════════════════════════════════════════════════
log_section "HEALTH & DOCS"
# ═══════════════════════════════════════════════════════════════════════════════
test_endpoint "GET" "/health" "200"
test_endpoint "GET" "/api-doc/openapi.json" "200"
test_multi "GET" "/api/v1/docs" "200,401"
test_multi "GET" "/api/v1/redoc" "200,401"

# ═══════════════════════════════════════════════════════════════════════════════
log_section "SIGNAL ENDPOINTS (/api/v1/signal/*)"
# ═══════════════════════════════════════════════════════════════════════════════
test_endpoint "GET" "/api/v1/signal/health" "200"
test_endpoint "POST" "/api/v1/signal/token" "401" "" '{}'  # Requires auth

# ═══════════════════════════════════════════════════════════════════════════════
log_section "AUTH ENDPOINTS (/api/v1/auth/*)"
# ═══════════════════════════════════════════════════════════════════════════════
test_endpoint "GET" "/api/v1/auth/setup/status" "200"
test_endpoint "POST" "/api/v1/auth/login" "401" "" '{"username":"","password":""}'
test_endpoint "POST" "/api/v1/auth/signup" "400" "" '{}'
test_endpoint "POST" "/api/v1/auth/setup/verify-key" "401"

# Try login
echo "Attempting login..."
LOGIN_RESPONSE=$(curl -s -X POST "${BASE_URL}/api/v1/auth/login" -H "Content-Type: application/json" -d '{"username":"admin@kyx.tech","password":"Admin123!"}' 2>/dev/null || echo "{}")
TOKEN=$(echo "$LOGIN_RESPONSE" | jq -r '.access_token // empty' 2>/dev/null || echo "")
[[ -n "$TOKEN" && "$TOKEN" != "null" ]] && log_pass "Login successful" || { log_skip "Login - using 401 expectations" "no credentials"; TOKEN=""; }

# User sessions
if [[ -n "$TOKEN" ]]; then
    test_endpoint "GET" "/api/v1/auth/sessions" "200" "$TOKEN"
    test_multi "DELETE" "/api/v1/auth/sessions/test-sid" "200,404" "$TOKEN"
    test_endpoint "GET" "/api/v1/auth/admin/sessions" "200" "$TOKEN"
else
    test_endpoint "GET" "/api/v1/auth/sessions" "401"
    test_endpoint "GET" "/api/v1/auth/admin/sessions" "401"
fi

# ═══════════════════════════════════════════════════════════════════════════════
log_section "ME ENDPOINTS (/api/v1/me/*)"
# ═══════════════════════════════════════════════════════════════════════════════
if [[ -n "$TOKEN" ]]; then
    test_endpoint "GET" "/api/v1/me/preferences" "200" "$TOKEN"
    test_endpoint "GET" "/api/v1/me/menus" "200" "$TOKEN"
    test_endpoint "PATCH" "/api/v1/me/preferences" "200" "$TOKEN" '{"theme_mode":"dark"}'
else
    test_endpoint "GET" "/api/v1/me/preferences" "401"
fi

# ═══════════════════════════════════════════════════════════════════════════════
log_section "ADMIN ENDPOINTS (/api/v1/admin/*)"
# ═══════════════════════════════════════════════════════════════════════════════
if [[ -n "$TOKEN" ]]; then
    # Config & Settings
    test_endpoint "GET" "/api/v1/admin/config" "200" "$TOKEN"
    test_endpoint "GET" "/api/v1/admin/settings" "200" "$TOKEN"
    
    # Users
    test_endpoint "GET" "/api/v1/admin/users" "200" "$TOKEN"
    test_multi "PATCH" "/api/v1/admin/users/${TEST_UUID}" "200,404" "$TOKEN" '{"full_name":"test"}'
    test_multi "DELETE" "/api/v1/admin/users/${TEST_UUID}" "200,400,404" "$TOKEN"
    
    # Tenants
    test_endpoint "GET" "/api/v1/admin/tenants" "200" "$TOKEN"
    test_endpoint "GET" "/api/v1/admin/tenants/me" "200" "$TOKEN"
    test_multi "GET" "/api/v1/admin/tenants/${TEST_UUID}" "200,404" "$TOKEN"
    
    # Roles
    test_endpoint "GET" "/api/v1/admin/roles" "200" "$TOKEN"
    test_multi "PATCH" "/api/v1/admin/roles/${TEST_UUID}" "200,404" "$TOKEN" '{"name":"test"}'
    test_multi "GET" "/api/v1/admin/roles/${TEST_UUID}/permissions" "200,404" "$TOKEN"
    
    # Permissions
    test_endpoint "GET" "/api/v1/admin/permissions" "200" "$TOKEN"
    test_multi "PATCH" "/api/v1/admin/permissions/${TEST_UUID}" "200,403,404" "$TOKEN" '{"name":"test"}'
    
    # Audit Logs
    test_endpoint "GET" "/api/v1/admin/logs" "200" "$TOKEN"
    
    # API Keys
    test_endpoint "POST" "/api/v1/admin/api-keys" "400" "$TOKEN" '{}'
    
    # CORS
    test_endpoint "GET" "/api/v1/admin/cors" "200" "$TOKEN"
    
    # i18n
    test_endpoint "GET" "/api/v1/admin/i18n/locales" "200" "$TOKEN"
    test_endpoint "GET" "/api/v1/admin/i18n/translations" "200" "$TOKEN"
    
    # Themes
    test_endpoint "POST" "/api/v1/admin/themes/import" "400" "$TOKEN"
    test_multi "PATCH" "/api/v1/admin/themes/${TEST_UUID}/activate" "200,404" "$TOKEN" '{"mode":"light"}'
    test_multi "DELETE" "/api/v1/admin/themes/${TEST_UUID}" "204,400,403,404" "$TOKEN"
    
    # Plugins
    test_endpoint "GET" "/api/v1/admin/plugins" "200" "$TOKEN"
    test_multi "GET" "/api/v1/admin/plugins/${TEST_UUID}" "200,404" "$TOKEN"
    test_multi "POST" "/api/v1/admin/plugins/${TEST_UUID}/enable" "200,404" "$TOKEN"
    test_multi "POST" "/api/v1/admin/plugins/${TEST_UUID}/disable" "200,404" "$TOKEN"
    
    # CMS Pages
    test_endpoint "GET" "/api/v1/admin/cms/pages" "200" "$TOKEN"
    test_multi "GET" "/api/v1/admin/cms/pages/${TEST_UUID}" "200,404" "$TOKEN"
    test_endpoint "POST" "/api/v1/admin/cms/pages" "400" "$TOKEN" '{}'
    test_multi "PUT" "/api/v1/admin/cms/pages/${TEST_UUID}" "200,400,404" "$TOKEN" '{"title":"test"}'
    test_multi "DELETE" "/api/v1/admin/cms/pages/${TEST_UUID}" "200,404" "$TOKEN"
    
    # Resource Sharing
    test_multi "GET" "/api/v1/admin/shares" "200,401" "200,401" "$TOKEN"
    test_multi "GET" "/api/v1/admin/shares/received" "200,401" "200,401" "$TOKEN"
    test_multi "POST" "/api/v1/admin/shares" "400,401" "$TOKEN" '{}'
    test_multi "DELETE" "/api/v1/admin/shares/${TEST_UUID}" "200,401,404" "$TOKEN"
    test_multi "GET" "/api/v1/admin/shares/${TEST_UUID}/usage" "200,401,404" "$TOKEN"
    
    # Branding
    test_endpoint "GET" "/api/v1/admin/branding" "200,404" "$TOKEN"
    test_endpoint "PATCH" "/api/v1/admin/branding" "400,404" "$TOKEN" '{}'
    test_endpoint "GET" "/api/v1/admin/branding/contexts" "200,404" "$TOKEN"
    test_multi "GET" "/api/v1/admin/branding/console" "200,404,404" "$TOKEN"
    test_multi "PATCH" "/api/v1/admin/branding/workspace" "200,404,400,404,404" "$TOKEN" '{"app_name":"test"}'
else
    test_endpoint "GET" "/api/v1/admin/config" "401"
    test_endpoint "GET" "/api/v1/admin/users" "401"
    test_endpoint "GET" "/api/v1/admin/tenants" "401"
    test_endpoint "GET" "/api/v1/admin/roles" "401"
    test_endpoint "GET" "/api/v1/admin/permissions" "401"
    test_multi "GET" "/api/v1/admin/plugins" "400,401"
fi

# ═══════════════════════════════════════════════════════════════════════════════
log_section "MEDIA ENDPOINTS (/api/v1/media/*)"
# ═══════════════════════════════════════════════════════════════════════════════
if [[ -n "$TOKEN" ]]; then
    test_endpoint "POST" "/api/v1/media" "400" "$TOKEN"
    test_endpoint "GET" "/api/v1/media" "200" "$TOKEN"
    test_endpoint "POST" "/api/v1/media/folders" "400" "$TOKEN" '{}'
else
    test_endpoint "POST" "/api/v1/media" "401"
fi
test_multi "GET" "/api/v1/media/${TEST_UUID}/test.png" "200,404"

# ═══════════════════════════════════════════════════════════════════════════════
TOTAL=$((PASS + FAIL + SKIP))
echo ""
echo "╔═══════════════════════════════════════════════════════════════════════════╗"
echo "║                           TEST SUMMARY                                     ║"
echo "╠═══════════════════════════════════════════════════════════════════════════╣"
echo -e "║  ${GREEN}PASS: $PASS${NC}"
echo -e "║  ${RED}FAIL: $FAIL${NC}"
echo -e "║  ${YELLOW}SKIP: $SKIP${NC}"
echo "║  ─────────────────────────────────────────────────────────────────────────"
echo "║  TOTAL: $TOTAL endpoints tested"
echo "╚═══════════════════════════════════════════════════════════════════════════╝"

[[ $FAIL -gt 0 ]] && { echo -e "${RED}Some tests failed!${NC}"; exit 1; } || { echo -e "${GREEN}All tests passed!${NC}"; exit 0; }
