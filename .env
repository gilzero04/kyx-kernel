# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT MODE
# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT controls system behavior including API docs access:
#
# ┌─────────────────┬────────────────────────────────────────────────────────────┐
# │ Value           │ Behavior                                                    │
# ├─────────────────┼────────────────────────────────────────────────────────────┤
# │ local           │ Development mode - API docs open, verbose logging          │
# │ development     │ Development mode - API docs open, verbose logging          │
# │ staging         │ Pre-production - API docs require Basic Auth               │
# │ production      │ Production mode - API docs require Basic Auth              │
# └─────────────────┴────────────────────────────────────────────────────────────┘
ENVIRONMENT=local

# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════
APP_NAME="Kyx Kernel"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY (REQUIRED: Change in production!)
# ═══════════════════════════════════════════════════════════════════════════════
JWT_SECRET=1f581796f4c5c4cb58b3b26023cca0dec60512936d69243c97bbc0a66983e770
ENGINE_SECRET_KEY=5a9f65ede21977564d7a6ad7c1ace4c2a2aba3f0ed21d848befb18dd554d44d7

# API Documentation Credentials (used when ENVIRONMENT=staging/production)
DOCS_USER=admin
DOCS_PASSWORD=MySecur3Pass!

# Database (Centralized Infrastructure)
DB_USER=infra_admin
DB_PASSWORD=infra_secure_pass
DB_NAME=infra_db
DATABASE_URL=postgres://infra_admin:infra_secure_pass@127.0.0.1:5435/infra_db?sslmode=require

# Redis Stack (Centralized Infrastructure)
REDIS_URL=rediss://127.0.0.1:6381
REDIS_PASSWORD=0YiivKoZ30Scc6GAgn8VwGY6CkQPSzUh5c9AaPnr6tI=
REDIS_CORS_KEY=config:cors_origins
# Redis Isolation (Cache=0, Session=1, Queue=2)
REDIS_CACHE_URL=rediss://127.0.0.1:6381/0
REDIS_SESSION_URL=rediss://127.0.0.1:6381/1
REDIS_QUEUE_URL=rediss://127.0.0.1:6381/2
